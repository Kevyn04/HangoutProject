spring.application.name=hangout-backend
server.port=8080

# MySQL connection — copy this file to application.properties and fill in your values
spring.datasource.url=jdbc:mysql://localhost:3306/hangout_db
spring.datasource.username=YOUR_DB_USERNAME
spring.datasource.password=YOUR_DB_PASSWORD
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA / Hibernate
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# ── Security / Request size limits ────────────────────────────────────
# Reject payloads larger than 64 KB (prevents large body DoS)
server.tomcat.max-http-form-post-size=65536
server.tomcat.max-swallow-size=65536
spring.servlet.multipart.max-file-size=2MB
spring.servlet.multipart.max-request-size=2MB
