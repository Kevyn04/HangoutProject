# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Supabase project URL (found in: Project Settings → API)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase anon/public key (found in: Project Settings → API)
# This key is safe to embed in client apps — security comes from RLS policies.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

EXPO_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
